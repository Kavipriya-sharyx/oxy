PORT=8000

# Database (Postgres)
DB_HOST=localhost
# 5433 = docker-compose Postgres (use 5432 for a local install)
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=oxxy
# Keep false once the schema comes from migrations (npm run db:setup). true lets the old entities rewrite it.
DB_SYNC=false
DB_SEED=true
DB_LOG=false

# Auth
SECERT_KEY=change-me
TOKEN_SECRET=change-me
ExpiresIn=1d
AUDIT_LOG=true

# Redis (used by CacheService)
REDIS_HOST=localhost
# 6380 = docker-compose Redis (use 6379 for a local install)
REDIS_PORT=6380
# Redis database number and the prefix of every queue / lock key. Give the tests and scripts
# their own values (e.g. REDIS_DB=15, QUEUE_PREFIX=oxxy-test) so they never share jobs with the dev server.
REDIS_DB=0
QUEUE_PREFIX=oxxy

# Oxxy chatbot
ANTHROPIC_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional: where WhatsApp sends go. Default is Meta. Point it at a local mock server for live checks.
WHATSAPP_API_BASE=https://graph.facebook.com

# Forgot-password email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Oxxy
DOMAIN_NAME=http://localhost:3000/

# Audit log (InfluxDB) - required for the app to start
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_DB=audit

# CRM sync (off by default). When true, bot changes are also sent to the CRM through an outbox + BullMQ worker (needs Redis)
CRM_ENABLED=false
# The CRM's API root, e.g. https://crm.example.com/api/v1. Paths follow Full Plan 3.2 [CONFIRM with the CRM team]:
# GET /customers?whatsapp=, PUT /customers/{whatsapp}, POST /booking-requests, /tasks, /activations,
# /customers/{id}/events, /customers/{id}/opt-out
CRM_BASE_URL=
CRM_API_KEY=
CRM_WEBHOOK_SECRET=
# 0 = keep retrying for 24 hours (1, 5, 15, 60 min, then hourly), then dead letter
CRM_MAX_ATTEMPTS=0
# Key for the Playbook 17.1 actions API (/api/v1/Actions, header X-Api-Key) used by the CRM and voice AI.
# Leave empty to switch the API off. Use a long random value, e.g. openssl rand -hex 32
ACTIONS_API_KEY=

# Production only (NODE_ENV=production): demo users are never created there. The first Super Admin
# comes from these two values (password at least 12 characters); change it after the first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Console URLs allowed to call the API (comma separated). Default: http://localhost:5173,http://localhost:8080
CORS_ORIGINS=
# API docs at /swagger: on in development, off in production unless SWAGGER=true
SWAGGER=

# Senior callback windows (Trigger O) are offered only inside team hours, IST [CONFIRM with the sales team]
TEAM_HOURS=10-19
# 0 = Sunday ... 6 = Saturday
TEAM_DAYS=1-6
# Data retention: days without a message before personal data is removed [CONFIRM with legal]. Empty = nothing removed
RETENTION_DAYS=
# Shown in the health-data notice and the privacy reply (Playbook 16.3) [CONFIRM]. Empty = OXXY_SUPPORT_EMAIL / info@oxxy.in
OXXY_PRIVACY_CONTACT=
# Decision journey (Playbook 1.3): days without a reply before the next message starts a new journey [CONFIRM]
JOURNEY_DAYS=7
# Playbook 8 [CONFIRM]: how a monthly Cut Medi Bills mandate is cancelled (e.g. "the link in your mandate SMS"). Unset = the question goes to a person.
CMB_CANCELLATION_METHOD=
# Full Plan 11 alerts: Slack / Teams / Google Chat incoming-webhook URL ({"text": ...}). Unset = alerts only in the log.
ALERT_WEBHOOK_URL=
ALERT_THROTTLE_MIN=30
HEALTH_CHECK_SECONDS=60
