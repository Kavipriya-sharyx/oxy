PORT=8000

# Database (Postgres)
DB_HOST=localhost
# 5433 = docker-compose Postgres (use 5432 for a local install)
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=oxxy
DB_SYNC=true
DB_SEED=true
DB_LOG=false

# Auth
SECERT_KEY=change-me
TOKEN_SECRET=change-me
ExpiresIn=1d
AUDIT_LOG=true

# Redis (used by CacheService)
REDIS_HOST=localhost
# 6380 = docker-compose Redis (use 6379 for a local install)
REDIS_PORT=6380

# Oxxy chatbot
ANTHROPIC_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Forgot-password email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Oxxy
DOMAIN_NAME=http://localhost:3000/

# Audit log (InfluxDB) - required for the app to start
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_DB=audit
