# Backend base URL (no trailing slash, no /api/v1)
VITE_API_URL=http://localhost:8000

# Optional: browser key for the centres map in the console (Maps JavaScript API, restricted to this site).
# It is a different key from the server-side GOOGLE_MAPS_API_KEY. Without it the map is shown as lists.
VITE_GOOGLE_MAPS_BROWSER_KEY=
